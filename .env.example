# Placement Tracker Environment Variables

# Google Gemini API Key for parsing placement notification emails
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Server Port (optional, defaults to 3001)
PORT=3001

# Database file path (optional, defaults to placement.db)
DB_PATH=placement.db

# make passwords here
PASSWORD=
ADMIN_PASSWORD=

# Google Cloud & VM Deployment (Used by scripts/*.sh)
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-west1-b
GCP_VM_NAME=db-tracker
GCP_REGION=us-west1
GCP_REPO_NAME=tracker-repo