{
  "name": "placement-tracker",
  "version": "1.0.0",
  "description": "Student placement tracking platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:temp": "concurrently \"npm run dev:backend:temp\" \"npm run dev:frontend:temp\"",
    "dev:backend:temp": "tsx watch src/backend/temp_index.ts",
    "dev:frontend:temp": "vite --config vite.temp.config.js",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "setup:db": "tsx src/backend/scripts/setup-db.ts",
    "import:data": "tsx src/backend/scripts/import-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.2",
    "better-sqlite3": "^13.0.2",
    "hono": "^4.6.2",
    "papaparse": "^5.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/papaparse": "^5.3.14",
    "concurrently": "^9.0.1",
    "svelte": "^4.2.19",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
