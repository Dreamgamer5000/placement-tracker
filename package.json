{
  "name": "placement-tracker",
  "version": "1.0.0",
  "description": "Student placement tracking platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "dev:temp": "npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "setup:db": "tsx src/backend/scripts/setup-db.ts",
    "import:data": "tsx src/backend/scripts/import-data.ts",
    "import:company-details": "tsx src/backend/scripts/import-company-details.ts",
    "match:neoids": "tsx src/backend/scripts/match-names-neoids.ts",
    "review:unmatched": "tsx src/backend/scripts/review-unmatched.ts",
    "sync:neoids": "tsx src/backend/scripts/sync-matched-neoids.ts",
    "update:masters": "tsx src/backend/scripts/update-masters-batch.ts",
    "recalculate:analytics": "tsx src/backend/scripts/recalculate-analytics.ts",
    "update-tracker-db": "bash ./update-tracker-db.sh",
    "docker:test": "bash ./test-docker.sh",
    "docker:compose": "docker compose up --build"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.2",
    "better-sqlite3": "^13.0.2",
    "hono": "^4.6.2",
    "papaparse": "^5.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/papaparse": "^5.3.14",
    "concurrently": "^9.0.1",
    "svelte": "^4.2.19",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
